// Auto-generated by Noctalia's color-scheme templating.
// Do not edit by hand - it is overwritten every time the wallpaper/theme
// changes. Included from niri's main config via `extraSettings`.
layout {
    border {
        active-color "{{colors.primary.default.hex}}"
        inactive-color "{{colors.surface_variant.default.hex}}"
    }
    shadow {
        color "{{colors.shadow.default.hex}}"
    }
    insert-hint {
        color "{{colors.primary.default.hex}}"
    }
}
